class Solution(object):
    def isAnagram(self, s, t):
        """
        Problem:
        Given two strings, determine if one string is an anagram of the other.

        Approach:
        Use hash maps to count the frequency of each character in both strings.
        If the two frequency maps contain the same characters with the same
        counts, the strings are anagrams.

        Time Complexity: O(n)
        Space Complexity: O(n)

        Pattern:
        Hash Map / Frequency Counting
        """

        if len(s) != len(t):
            return False

        s_count = {}
        t_count = {}

        for letter in s:
            count = s_count.get(letter, 0)
            count += 1
            s_count[letter] = count

        for letter in t:
            count = t_count.get(letter, 0)
            count += 1
            t_count[letter] = count

        return s_count == t_count
