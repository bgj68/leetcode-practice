class Solution(object):
    def search(self, nums, target):
        """
        Problem:
        Given a sorted array of integers, return the index of the target.
        Return -1 if the target does not exist.

        Approach:
        Use binary search to repeatedly divide the sorted array in half.
        Compare the middle element with the target and eliminate the half
        that cannot contain the answer.

        Time Complexity: O(log n)
        Space Complexity: O(1)

        Pattern:
        Binary Search / Divide and Conquer
        """

        left = 0
        right = len(nums) - 1

        while left <= right:
            mid = (left + right) // 2

            if nums[mid] == target:
                return mid

            elif nums[mid] < target:
                left = mid + 1

            else:
                right = mid - 1

        return -1
